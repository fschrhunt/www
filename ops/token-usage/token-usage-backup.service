[Unit]
Description=Archive usage counters privately off server
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=token-usage
Group=token-usage
WorkingDirectory=/srv/apps/token-usage/current
LoadCredential=backup-config:/srv/apps/token-usage/shared/env/backup-config.json
LoadCredential=codex-snapshot:/srv/apps/token-usage/shared/data/snapshot.json
LoadCredential=opencode-snapshot:/srv/apps/token-usage/shared/data/opencode-snapshot.json
LoadCredential=claude-snapshot:/srv/apps/token-usage/shared/claude/claude-snapshot.json
LoadCredential=codex-local-snapshot:/srv/apps/token-usage/shared/claude/codex-local-snapshot.json
ExecStart=/usr/bin/python3 -B /srv/apps/token-usage/current/backup_usage.py --codex %d/codex-snapshot --codex-local %d/codex-local-snapshot --opencode %d/opencode-snapshot --claude %d/claude-snapshot --prices /srv/apps/token-usage/current/pricing.json --config %d/backup-config --data /srv/apps/token-usage/shared/data
UMask=0077
TimeoutStartSec=180
MemoryMax=96M
CPUQuota=10%
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/token-usage/shared/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
