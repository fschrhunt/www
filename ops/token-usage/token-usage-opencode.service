[Unit]
Description=Collect private OpenCode daily model costs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=token-usage
Group=token-usage
WorkingDirectory=/srv/apps/token-usage/current
LoadCredential=opencode-auth:/srv/apps/token-usage/shared/env/opencode-auth
LoadCredential=opencode-config:/srv/apps/token-usage/shared/env/opencode-config.json
ExecStart=/usr/bin/python3 -B /srv/apps/token-usage/current/opencode_collector.py --auth %d/opencode-auth --config %d/opencode-config --data /srv/apps/token-usage/shared/data
UMask=0077
TimeoutStartSec=180
MemoryMax=256M
CPUQuota=25%
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/token-usage/shared/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
