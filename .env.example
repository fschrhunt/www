# Server-only Resend key with sending access to the verified domain.
RESEND_API_KEY=
CONTACT_FROM="fschrhunt.com <contact@fschrhunt.com>"

# Optional shared rate-limit store. Set both to make the /api/contact limit
# durable across serverless instances; without them it falls back to a
# per-instance in-memory limit. Vercel KV injects KV_REST_API_URL and
# KV_REST_API_TOKEN; an Upstash Redis database provides UPSTASH_REDIS_REST_URL
# and UPSTASH_REDIS_REST_TOKEN. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
