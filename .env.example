# Server-only Resend key with sending access to the verified domain.
RESEND_API_KEY=
CONTACT_FROM="fschrhunt.com <contact@fschrhunt.com>"

# Required shared rate-limit store for the deployed site.
# Missing configuration or store failures return 503 and preserve the draft.
# Local development without a store uses memory. An Upstash Redis database
# provides KV_REST_API_URL and KV_REST_API_TOKEN, or UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN. Either pair works. Copy this file to .dev.vars for
# `npm run preview`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
