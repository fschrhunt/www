---
/** One authored writings page, rendered inside the shared reader layout. */
import Reader from "../../layouts/Reader.astro";
import { loadCollection } from "../../lib/collections";

export function getStaticPaths() {
  return loadCollection("writings").map(({ entry, Content }) => ({ params: { slug: entry.slug }, props: { entry, Content } }));
}
const { entry, Content } = Astro.props;
---

<Reader entry={entry} collection="writings"><Content /></Reader>
