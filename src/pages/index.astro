---
/** A personal letter with an inline About passage, products, writings, and contact hub. */
import Site from "../layouts/Site.astro";
import Portrait from "../components/Portrait.astro";
import SocialHub from "../components/SocialHub.astro";
import { AboutPassage } from "../components/about-passage";
import { ScrambleLink } from "../components/scramble-link";
import { getContentEntries } from "../lib/collections";
import siteUpdate from "../site-updated.json";

const products = getContentEntries("products");
const writings = getContentEntries("writings");
const month = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const day = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Site path="/">
  <a class="skip-link" href="#main">Skip to content</a>
  <main id="main" class="letter">
    <Portrait />
    <header class="letter-note">
      <p class="muted">Hello, I’m Fischer. <span class="name-pronunciation"><span aria-hidden="true">/'fish-er/</span><span class="sr-only">Pronounced fish-er.</span></span></p>
      <h1>I build things. What they add up to, I'm still figuring out.</h1>
    </header>
    <AboutPassage client:load />
    <section class="products" aria-labelledby="products-heading">
      <h2 id="products-heading">Products</h2>
      <ul>
        {products.map(product => <li>
          <ScrambleLink client:load href={`/products/${product.slug}`} className={product.slug === "e" ? "product-e" : undefined}>{product.indexLabel ?? product.title}</ScrambleLink>
          <time datetime={product.date} title="Repository created">{month.format(new Date(product.date))}</time>
        </li>)}
      </ul>
    </section>
    <section class="products writings" aria-labelledby="writings-heading">
      <h2 id="writings-heading">Writings</h2>
      <ul>{writings.map(writing => <li>
        <ScrambleLink client:load href={`/writings/${writing.slug}`}>{writing.title}</ScrambleLink>
        <span class="reading-time">{writing.readingTime}</span>
      </li>)}</ul>
    </section>
    <footer class="letter-footer"><time datetime={siteUpdate.updatedAt}>Updated {day.format(new Date(siteUpdate.updatedAt))}</time><a class="token-usage-link" href="/token-usage" aria-label="Token usage" title="Token usage"><img src="/chip.svg" alt="" width="28" height="28" loading="lazy" /></a></footer>
  </main>
  <SocialHub />
</Site>
