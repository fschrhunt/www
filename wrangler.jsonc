{
  // fschrhunt.com on Cloudflare Workers: prerendered pages served as static assets,
  // with the contact API and the token-usage snapshot run by the Worker.
  // The Astro build fills in the entry and assets; `npm run deploy` builds and ships
  // it, and CI deploys main. The one secret, RESEND_API_KEY, is set once with
  // `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fschrhunt",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "fschrhunt.com", "custom_domain": true },
    { "pattern": "www.fschrhunt.com", "custom_domain": true }
  ],
  // Astro sessions use this namespace. Declare it so deploys never auto-provision a duplicate.
  "kv_namespaces": [{ "binding": "SESSION", "id": "a2a5db11ec1c453483f45c586111f814" }],
  // The public usage snapshot the token-usage publisher writes; /token-usage/data.json serves it.
  "r2_buckets": [{ "binding": "TOKEN_USAGE", "bucket_name": "token-usage" }],
  // Contact attempts per IP, counted across every Worker instance (src/lib/rate-limiter.ts).
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": { "enabled": true }
}
